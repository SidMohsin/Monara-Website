# Public site URL once the domain is confirmed (enables indexing, canonical URLs, sitemap URLs).
# Leave empty during review: the whole site is noindex while this is unset.
NEXT_PUBLIC_SITE_URL=

# Form endpoint (e.g. a free Formspree/Web3Forms endpoint). While empty, the contact form
# shows that it is not connected and does not pretend to send.
NEXT_PUBLIC_FORM_ENDPOINT=

# Set to "true" on review builds to show small "Draft" badges on text awaiting client approval.
NEXT_PUBLIC_SHOW_DRAFTS=
