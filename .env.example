# Optional override for the canonical domain. Not needed on Vercel: production builds use
# site.url (https://monaraproductions.com, src/content/site.js) and are indexable; preview and
# local builds stay noindex.
NEXT_PUBLIC_SITE_URL=

# Optional override for the contact form endpoint. The Formspree URL is set in
# src/content/site.js (formEndpoint), so this can stay empty.
NEXT_PUBLIC_FORM_ENDPOINT=

# Set to "true" on review builds to show small "Draft" badges on text awaiting client approval.
NEXT_PUBLIC_SHOW_DRAFTS=
